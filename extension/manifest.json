{
  "manifest_version": 3,
  "name": "Discord Live Sentiment",
  "version": "1.0.0",
  "description": "Livestreams the Discord conversation you can see to a local sentiment server for live analysis.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://ptb.discord.com/*",
        "https://canary.discord.com/*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Discord live sentiment" }
}
